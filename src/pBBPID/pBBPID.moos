//----------------------------------------------------------
// pBBPID example configuration block
//
// Cascaded PID:  speed -> thrust,  heading -> yaw-rate -> rudder
// Feeds DESIRED_THRUST / DESIRED_RUDDER to pThrustMix.
//
// IMPORTANT: when running pBBPID, pThrustMix must be a PURE MIXER.
// Disable its internal yaw scheme so the two controllers don't fight:
//     enable_yaw_feedback = false
//     enable_speed_scaling = false
//----------------------------------------------------------
ProcessConfig = pBBPID
{
  AppTick   = 10
  CommsTick = 10

  // Gains:  param = Kp, Ki, Kd
  speed_pid   = 20, 5, 0       // thrust per (m/s) of speed error
  heading_pid = 1.0, 0, 0      // outer: heading err (deg) -> yaw rate (deg/s)
  yawrate_pid = 2.0, 0.1, 0    // inner: yaw-rate err (deg/s) -> rudder

  // Limits
  max_thrust             = 100
  max_rudder             = 100
  max_yawrate            = 25     // deg/s; default cap (overridden by schedule)
  speed_integral_limit   = 50
  yawrate_integral_limit = 50

  // Gain scheduling on measured speed (NAV_SPEED).
  //   - Linearly interpolates the inner yaw-rate PID gains + max_yawrate
  //     between breakpoints; holds endpoint values outside the range.
  //   - This is the answer to the deep-hull problem: at low speed you can
  //     turn on a dime (high Kp, large rate cap); at speed the hull resists,
  //     so back Kp off and cap the commanded rate to avoid saturating rudder.
  //   - When enabled, the schedule OWNS the yaw-rate gains each tick, so
  //     live BBPID_YAWRATE_K* pokes are overwritten; retune the table instead.
  enable_gain_schedule = true
  schedule_point = speed=0.5, kp=3.0, ki=0.10, kd=0.0,  max_yawrate=30
  schedule_point = speed=1.5, kp=2.0, ki=0.10, kd=0.0,  max_yawrate=20
  schedule_point = speed=3.0, kp=1.2, ki=0.05, kd=0.2,  max_yawrate=12

  // Conventions -- VERIFY ON THE BENCH:
  //  - yawrate_scale converts GYRO_Z_LVL_IMU to deg/s and fixes its sign.
  //    Use 57.2958 if the gyro reports rad/s; use -57.2958 if sign is inverted.
  //  - rudder_polarity flips DESIRED_RUDDER sign to match the mixer.
  yawrate_scale    = 57.2958
  rudder_polarity  = 1
  allow_reverse    = false
  command_stale_thresh = 1.5    // s; zero outputs if helm stops commanding

  // Controller lifecycle (0/false = legacy; see plug_pBBPID.moos for the
  // rationale): FF hold expiry + repositioning-step guard, dt credit cap,
  // authority-aware integration gate.
  ff_hold_time      = 2.0       // s; zero held FF after command settles
  ff_step_limit     = 150       // deg; larger steps publish no FF
  max_dt            = 0.5       // s; max Ki*e*dt credit per tick
  antiwindup        = true      // tracking AW at output/FF/mixer rails
  integrate_gate    = true      // integrate only under AUTONOMY && stop NONE
  gate_stale_thresh = 2.0       // s; stale gate inputs -> freeze + warn

  // Variable name overrides (defaults shown)
  // desired_speed_var   = DESIRED_SPEED
  // desired_heading_var = DESIRED_HEADING
  // nav_speed_var       = NAV_SPEED
  // nav_heading_var     = NAV_HEADING
  // nav_yawrate_var     = GYRO_Z_LVL_IMU
  // thrust_var          = DESIRED_THRUST
  // rudder_var          = DESIRED_RUDDER
}
