//----------------------------------------------------------
// GENERATED by gen_turn_schedule.py -- do not edit by hand.
//   speeds 0.75,1.0,1.25,1.5  trials 2  dir star  mod_hdg 90  fix 355  timeout 75
//   leg 45,-40,40,65  turn_rad 7  check_radius 6
//----------------------------------------------------------

Behavior = BHV_LegRun
{
  name      = legs
  pwt       = 100
  condition = MODE == LEG_RUNNING
  updates   = LEG_UPDATE
  perpetual = true

            lead = 6
     lead_damper = 1
           speed = 0.75
    capture_line = true
  capture_radius = 2
     slip_radius = 6
        patience = 90

             leg = x=45,y=-40,len=40,ang=65
      turn1_bias = 0
      turn2_bias = 0
       turn1_dir = port
       turn2_dir = star
        turn_rad = 7
   init_leg_mode = far_turn   // first leg runs to the FAR end: a full approach leg
          repeat = 10000   // ended by the last turn's flags, not by count

  // One leg per turn. The leg before each turn runs at that turn's
  // speed; end turns keep the most recent leg speed (onturn=true) so
  // the boat arrives on the next leg already settled.
        leg_spds = 2:0.75,2:1,2:1.25,2:1.5
  leg_spds_onturn = true
  leg_spds_repeat = false
     mid_leg_pct = 50
    mid_leg_flag = FIX_TURN=true

  visual_hints = nextpt_color=yellow, nextpt_vertex_size=8, nextpt_lcolor=gray70
  visual_hints = vertex_color=dodger_blue, edge_color=white, vertex_size=6, edge_size=1
  visual_hints = turn_edge_color=gray80, turn_vertex_color=green
}

Behavior = BHV_FixedTurn
{
  name      = fturn
  pwt       = 100
  condition = MODE == FIX_TURNING
#ifdef XMODE BBOAT
  // Field only: an RC takeover idles the turn instead of letting
  // RC-driven heading change count toward it. On hand-back the
  // behavior restarts from 'stem' and the turn begins again.
  condition = BB_CMD_AUTHORITY = AUTONOMY
#endif
  updates   = FTURN_UPDATE
  perpetual = true

  fix_turn  = 355
  mod_hdg   = 90
  turn_dir  = star
  timeout   = 75
  turn_delay = 0
  stale_nav_thresh = 5
  schedule_repeat  = false

  endflag = TURNING_TIME = $[TURN_TIME]
  endflag = TURNING_DIST = $[TURN_DIST]

  // One turn_spec per trial, speed-major. Every turn hands control
  // back to the leg run; the last one ends the mission.
  turn_spec = spd=0.75, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  1/8: 0.75 m/s trial 1
  turn_spec = spd=0.75, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  2/8: 0.75 m/s trial 2
  turn_spec = spd=1, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  3/8: 1 m/s trial 1
  turn_spec = spd=1, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  4/8: 1 m/s trial 2
  turn_spec = spd=1.25, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  5/8: 1.25 m/s trial 1
  turn_spec = spd=1.25, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  6/8: 1.25 m/s trial 2
  turn_spec = spd=1.5, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false   //  7/8: 1.5 m/s trial 1
  turn_spec = spd=1.5, mhdg=90, fix=355, turn=star, timeout=75, flag=FIX_TURN=false, flag=LEG_RUN=false, flag=RETURN=true   //  8/8: 1.5 m/s trial 2
}
