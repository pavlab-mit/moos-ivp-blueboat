//------------------------------------------------------------
// turning_profiles behavior file. The LegRun / FixedTurn schedule
// and the op region are GENERATED into plugs/ by gen_turn_schedule.py
// (the launcher runs it); edit the generator, not the plugs.
//------------------------------------------------------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   STATION_KEEP = false
initialize   LEG_RUN = true
initialize   FIX_TURN = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
}

// FIX_TURNING is tested before LEG_RUNNING: while FIX_TURN is true
// the fixed turn owns the boat even though LEG_RUN stays true.
set MODE = FIX_TURNING {
  MODE = ACTIVE
  FIX_TURN = true
}

set MODE = LEG_RUNNING {
  MODE = ACTIVE
  LEG_RUN = true
}

#include plugs/plug_turn_schedule.bhv

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  condition  = MODE == RETURNING
  perpetual  = true
  updates    = RETURN_UPDATE
  endflag    = RETURN = false
  endflag    = DEPLOY = false
  endflag    = MISSION = complete

            lead = 6
     lead_damper = 1
   lead_to_start = true
           speed = 1.0
  capture_radius = 2.0
     slip_radius = 8.0

  points = $(RETURN_POS)
}

#include ../alpha_pavlab_asv/plugs/bhvs/std_bhvs/plug_stationkeep.bhv
#include plugs/plug_opregion.bhv
