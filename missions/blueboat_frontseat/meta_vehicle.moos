ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)_fs

#include plugs/blueboat_fs/plug_origin_warp.moos

//------------------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  //Core vehicle 
  Run = MOOSDB                 @ NewConsole = false
  Run = uProcessWatch          @ NewConsole = false
  // CRSF RC stack (iRCInterface). The SBUS fallback is a config
  // swap, not a rebuild: change these two iRCInterface lines back
  // to iRCReader + plug_iRCReader.moos. NEVER run both - they
  // would split one serial port and both would see corruption.
  Run = iRCInterface           @ NewConsole = false
  Run = iUnicore               @ NewConsole = false
  Run = pBBCommandArbiter      @ NewConsole = false
  Run = pThrustMix             @ NewConsole = false
  Run = iBBNavigatorInterface  @ NewConsole = false
  Run = iFrontSeatBroker       @ NewConsole = false
  Run = iTeleop                @ NewConsole = false
  Run = pBB_Status             @ NewConsole = false
  // Always on: lightweight, no disk footprint, and it is what
  // backs the 50 Hz claim with a measurement (plan section 7.4).
  Run = uLoadWatch             @ NewConsole = false

  // Logging stays DEBUG-gated by decision: shakeout runs launch
  // in debug anyway, and routine ops should not fill the Pi with
  // log files. NOTE the dock test and any run you may want to
  // replay offline MUST therefore launch with the debug flag --
  // no .alog, no traceability.
  #ifdef DEBUG true
  Run = uFldNodeBroker     @ NewConsole = false
  Run = pRealm             @ NewConsole = false
  Run = pShare             @ NewConsole = false
  Run = pHostInfo          @ NewConsole = false
  Run = pLogger            @ NewConsole = false
  #endif
}

#include plugs/blueboat_fs/plug_iFrontSeatBroker.moos
#include plugs/blueboat_fs/plug_iUnicore.moos
#include plugs/blueboat_fs/plug_iRCInterface.moos
#include plugs/blueboat_fs/plug_pBBCommandArbiter.moos
#include plugs/blueboat_fs/plug_pThrustMix.moos
#include plugs/blueboat_fs/plug_iBBNavigatorInterface.moos
#include plugs/blueboat_fs/plug_iTeleop.moos
#include plugs/blueboat_fs/plug_uProcessWatch.moos
#include plugs/blueboat_fs/plug_pBB_Status.moos
#include plugs/blueboat_fs/plug_uLoadWatch.moos

#ifdef DEBUG true
#include plugs/blueboat_fs/plug_pShare.moos
#include plugs/blueboat_fs/plug_pRealm.moos
#include plugs/blueboat_fs/plug_uFldNodeBroker.moos
#include plugs/blueboat_fs/plug_pHostInfo.moos
#include plugs/blueboat_fs/plug_pLogger.moos
#endif
