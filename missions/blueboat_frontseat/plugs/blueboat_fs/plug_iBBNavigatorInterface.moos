//----------------------------------------------------------
// iBBNavigatorInterface config block
//
// Unified Navigator Interface for Blueboat ASV, built on
// navigator-cpp (board revision V1/V2 and Pi 4/5 detected at
// runtime - one binary fleet-wide). Owns:
//   - Dual-thruster PWM (left/right ESCs) with per-boot arming
//   - AHRS (Allgeuer passive complementary filter, IMU +
//     optional magnetometer)
//   - Raw IMU / level-frame gyro publication
//   - ADC power monitoring (battery V / I)
//   - Internal pressure / temperature, leak detector
//   - Navigator-board RGBW LEDs
//
// It no longer arbitrates or mixes: one command input
// (BB_MIXED_CMD), plus the RC kill / deadman sidebands.
//----------------------------------------------------------

ProcessConfig = iBBNavigatorInterface
{
  AppTick   = 50
  CommsTick = 50

  //=========================================================
  // COMMAND PATH
  //=========================================================
  // The ONLY command input is BB_MIXED_CMD, from pThrustMix.
  // This app no longer arbitrates, mixes, filters, or applies a
  // deadband -- see docs/control_refactor_plan.md section 16.
  mixed_cmd_timeout_sec  = 0.5

  // How long a committed actuator frame stays valid to the PWM
  // thread. Past this the writer neutralises on its own, so a
  // stalled Iterate() cannot leave the props running on an old
  // command.
  actuator_frame_ttl_sec = 0.25

  //=========================================================
  // ESC ENDPOINTS -- the only place inversion is allowed
  //=========================================================
  // BlueBoat120, from the ArduRover 4.7 parameter file.
  // right = SERVO1 (not reversed), left = SERVO3 (reversed).
  //
  // NOTE trim is 1510, not 1500. The old code hardcoded 1500,
  // which is a permanent 10 us idle bias.
  //
  // CHANGED FROM 800/2200: under the old mapping 8.0% of real
  // commands (measured, via 5 Aug log) landed outside the ESC's
  // documented 1100-1900 window, 2.0% at 2200 us. The thrust
  // curve therefore CHANGES with this config -- retune expected.
  left_esc_min_us    = 1100
  left_esc_trim_us   = 1510
  left_esc_max_us    = 1900
  left_esc_reversed  = true

  right_esc_min_us   = 1100
  right_esc_trim_us  = 1510
  right_esc_max_us   = 1900
  right_esc_reversed = false

  left_thruster_pin  = 14
  right_thruster_pin = 16
  thruster_enabled   = true

  //=========================================================
  // ESC LIFECYCLE
  //=========================================================
  // 2 s neutral hold, run IN the PWM thread so it holds a signal
  // the ESC can actually see. NVGR_DISARM cycles this at runtime
  // to serve the handset's disarm/arm request.
  initialize_esc = true

  // false: pin state PERSISTS after exit, so the fleet safe state
  // is neutral-on-the-wire (props stopped, signal present), NOT
  // absence of signal.
  disarm_on_exit = false

  //=========================================================
  // RC DEADMAN -- opt-in blanket, default OFF
  //=========================================================
  // If enabled, RC link loss safes the boat in ANY mode,
  // including a healthy autonomous mission. It exists for running
  // experimental code. Turn it ON for the first water trials of
  // this refactor, OFF for over-the-horizon work.
  //
  // This is NOT the source lease -- that lives in the arbiter and
  // is never disableable.
  rc_deadman_enabled     = false
  rc_deadman_timeout_sec = 2.0

  //=========================================================
  // POWER MONITORING
  //=========================================================
  // Only nbats=4 has measured calibration.
  nbats                 = 4
  voltage_scale         = 11.132
  voltage_offset        = 0.0
  rolling_window_period = 2.0

  //=========================================================
  // AHRS / IMU
  //=========================================================
  // Allgeuer passive complementary filter, in navigator-cpp.
  //
  // NVGR_SENSOR_RATE_HZ reports the rate ACHIEVED. Believe that
  // number, not this one: the pre-rewrite loop slept on the wrong
  // interval and ran nearer 200-250 Hz with nothing showing it.
  sample_rate = 150

  // Magnetometer fusion off pending on-water characterisation.
  // navigator-cpp now dispatches V1 -> AK09915, V2 -> MMC5983;
  // the old code hardcoded the AK and would have read the wrong
  // part on a V2 board.
  use_mag = false

  mag_ak_cal_file = /home/pi/mag_cal/$(VNAME)/mag/mag_cal_nav.dat
  // imu_cal_file = /home/pi/mag_cal/$(VNAME)/imu/imu_cal.txt

  yaw_rate_clamp = 3.0

  roll_offset  = 0.0
  pitch_offset = 0.0
  yaw_offset   = 0.0

  declination_deg          = -14.058
  operating_heading_offset = 0.0

  ahrs_pub_suffix = AHRS
  imu_pub_suffix  = IMU

  debug = $(LOG)
}
