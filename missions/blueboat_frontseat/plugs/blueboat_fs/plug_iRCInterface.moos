//--------------------------------------------------------
// iRCInterface Config Block (CRSF successor to iRCReader)
//
// Wired into meta_vehicle.moos 2026-08-14 (replacing
// plug_iRCReader.moos). The HIL checklist (docs/archive/rc/
// rc_hil_test.md, with the corrected CH5/CH8 = 1/2 expectations)
// is run inside this full mission on the bench navigator, props
// off. SBUS fallback = swap the two iRCReader lines back in
// meta_vehicle.moos; never run both apps (one serial port).

ProcessConfig = iRCInterface
{
  AppTick    = 16
  CommsTick  = 16

  // UART wired to the CRSF receiver. 420k 8N1: any Pi UART
  // works -- no parity constraint, no disable-bt (that advice
  // was SBUS-only).
  //   RadioMaster XR4: /dev/ttyAMA1 (Navigator SERIAL 3)
  // Verify with: rc_probe -p crsf -d <dev>
  device = /dev/ttyAMA1

  // Telemetry back to the handset. Non-blocking writes; can
  // never stall RC decode.
  telemetry = true
  telem_hz  = 2     // battery + flight-mode string
  gps_hz    = 1     // GPS + distance, 0 = off

  // note: validated_channels is gone -- CRSF frames are
  // CRC-validated, so the SBUS range-check knob has no meaning.
}
