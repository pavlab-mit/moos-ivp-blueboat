//------------------------------------------------
// iBackSeatBroker config block

ProcessConfig = iBackSeatBroker
{
   AppTick   = 10
   CommsTick = 10

   //startup id
   startup_id_repeat_frames = 20

   // Backseat listens locally for front-seat telemetry.
   // In missions this usually maps to the vehicle-side IP.
   listen_ip   = $(IP_ADDR)
   listen_port = 9445

   // Backseat sends C2 to the front-seat endpoint.
   // In missions this usually maps to FSEAT_IP.
   tx_ip   = $(FSEAT_IP)
   tx_port = 9444

   // MOOS vars sent every Iterate tick if available
   // AUTONOMY_CMD is the command contract; the arbiter on the
   // front seat consumes it. The broker re-sends its latest field
   // map every tick, which is exactly why a repeated epoch+seq
   // does NOT refresh the arbiter's lease -- mail arriving is not
   // evidence pBBPID is alive.
   //
   // The string is full of commas and '='; lib_broker_v2
   // percent-encodes anything outside [A-Za-z0-9_-.:] so it
   // crosses intact as an opaque value.
   tx_vars = AUTONOMY_CMD,ALL_STOP,MISSION_COMPLETE, IVPHELM_STATE, MODE, DEPLOY

   // DESIRED_THRUST_L/R are RETIRED from the wire: mixing moved to
   // the front seat, so only semantic surge/yaw crosses the seat
   // boundary now.

   // Optional inbound remap: WIRE_VAR:MOOS_VAR
   // Backseat-side EKF / uBBBundler is the source of truth for
   // helm-facing NAV_*; leave empty unless you need a passthrough.
   // in_map =

   debug = false
}

