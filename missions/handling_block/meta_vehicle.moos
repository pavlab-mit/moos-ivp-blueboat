//------------------------------------------------------------
// handling_block -- the deliberate maneuver block (plan §8.3).
//
// Back-seat community with NO HELM: uTimerScript drives
// DESIRED_HEADING / DESIRED_SPEED straight into pBBPID, so every
// step is exact, every hold is exact, and the whole block replays
// offline. The script only advances while the arbiter says
// AUTONOMY is driving -- flip to RC to reposition and the block
// pauses; flip back and it resumes where it left off.
//
// Everything safety-relevant is unchanged from a normal mission:
// setpoints are re-posted every second so pBBPID's staleness
// gate, the arbiter's lease, RC kill and takeover all work
// exactly as in alpha_pavlab.
//
// Boat-specific plugs are INCLUDED FROM alpha_pavlab_asv so the
// pBBPID gains and broker wiring live in exactly one place.
//------------------------------------------------------------
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include ../alpha_pavlab_asv/plugs/shared_all/plug_origin_warp.moos

//------------------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB           @ NewConsole = false
  Run = pLogger          @ NewConsole = false
  Run = uProcessWatch    @ NewConsole = false
  Run = pShare           @ NewConsole = false
  Run = pHostInfo        @ NewConsole = false
  Run = pNodeReporter    @ NewConsole = false
  Run = uFldNodeBroker   @ NewConsole = false

  Run = iBackSeatBroker  @ NewConsole = false
  Run = pBB_DGPS_EKF     @ NewConsole = false
  Run = pBBPID           @ NewConsole = false
  Run = uTimerScript     @ NewConsole = false
}

#include ../alpha_pavlab_asv/plugs/blueboat/plug_iBackSeatBroker.moos
#include ../alpha_pavlab_asv/plugs/blueboat/plug_pBB_DGPS_EKF.moos
#include ../alpha_pavlab_asv/plugs/blueboat/plug_pBBPID.moos
#include ../alpha_pavlab_asv/plugs/shared_all/plug_uProcessWatch.moos
#include ../alpha_pavlab_asv/plugs/shared_all/plug_pShare.moos
#include ../alpha_pavlab_asv/plugs/shared_all/plug_pHostInfo.moos
#include ../alpha_pavlab_asv/plugs/shared_asv/plug_pNodeReporter.moos
#include ../alpha_pavlab_asv/plugs/shared_asv/plug_uFldNodeBroker.moos
#include ../alpha_pavlab_asv/plugs/shared_asv/plug_pLogger.moos

// Generated by gen_maneuver.py -- regenerate to change BASE_HDG
// or the sequence; do not edit by hand.
#include plugs/plug_uTimerScript.moos
