# Reference unit -- the front-seat mission, started on demand by bb_init.sh
# (via `systemctl start fs-mission.service`). You maintain the real copy of
# this; it is included here so bb_init.sh's launch step is self-documenting.
#
# Install with:
#     sudo cp scripts/systemd/fs-mission.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#   (Do NOT `enable` it -- bb_init.sh starts it only after the gates pass.)

[Unit]
Description=BlueBoat front-seat MOOS mission
# NO ordering on bb-init.service. bb_init.sh starts this unit explicitly via a
# synchronous `systemctl start`; an After=bb-init dep here deadlocks, because
# bb-init (Type=oneshot) stays "activating" until its script returns, while the
# script blocks waiting for this start job that systemd won't run until bb-init
# is active. fs-mission is on-demand only -- it must not be ordered after the
# thing that launches it.

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/moos-ivp-blueboat/missions/blueboat_frontseat
# A systemd unit has a bare PATH; launch_vehicle.sh needs pAntler, nsplug,
# mhash_gen, uMAC, and the repo's own binaries. List every dir they live in.
Environment=PATH=/home/pi/moos-ivp-blueboat/bin:/home/pi/moos-ivp/bin:/home/pi/moos-ivp/scripts:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Run the mission inside a detached `screen` session so you can attach to its
# live console after logging in:   screen -r fsmission   (detach: Ctrl-a d;
# read-along share: screen -x fsmission). Needs `screen` installed (apt).
#   -Dm  run screen in the FOREGROUND without forking, so systemd tracks it as
#        Type=simple and it exits when the mission exits (start-once preserved).
#   -S   session name.
# launch_vehicle.sh -a execs pAntler in the FOREGROUND (no uMAC). That foreground
# process is what holds the screen window -- and therefore the service -- open.
# WITHOUT -a the script backgrounds its apps and returns immediately, so screen
# exits and systemd tears the mission down (service goes inactive instantly).
# Attaching shows pAntler's live output (not an interactive uMAC). -nc skips the
# confirm.
# NOTE: mission stdout goes to the screen pty, not journald. To also keep a file
# copy, add `-L -Logfile /home/pi/fsmission.log` to the screen args below.
ExecStart=/usr/bin/screen -DmS fsmission /bin/bash -lc 'cd /home/pi/moos-ivp-blueboat/missions/blueboat_frontseat && exec ./launch_vehicle.sh -a -nc'
# Start-once semantics: bb_init.sh decides when to (re)start; do not loop here.
Restart=no

[Install]
WantedBy=multi-user.target
